---
// Interactive Leaflet map. Pass points from toMapPoint(). Set `filters` on the main map page.
interface Props {
  points: unknown[];
  size?: 'small' | 'normal' | 'full';
  route?: { main: [number, number][]; spurs: [number, number][][]; alts: [number, number][][] }; // trail lines
  filters?: boolean;    // wire up the #map-filters form
}
const { points, size = 'normal', route = false, filters = false } = Astro.props;
const id = `map-${Math.random().toString(36).slice(2, 8)}`;
---
<div
  id={id}
  class:list={['map', 'lg-map', size !== 'normal' && size]}
  data-route={route ? JSON.stringify(route) : undefined}
  data-filters={filters ? '1' : undefined}
  role="region"
  aria-label="Map of places"
>
  <script is:inline type="application/json" set:html={JSON.stringify(points)} />
</div>

<script>
  import { initMaps } from './map-client';
  initMaps();
</script>
