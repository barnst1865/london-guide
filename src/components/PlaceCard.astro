---
import type { Place } from '../lib/data';
import { u, typeInfo, badgeInfo } from '../lib/data';
import { TAGS } from '../lib/vocab.mjs';

interface Props { place: Place; }
const { place } = Astro.props;
const d = place.data;
const t = typeInfo(d.type);
const shownTags = d.tags.filter((x) => ['kid-friendly', 'free', 'rainy-day', 'booking-essential'].includes(x));
---
<a class="card" href={u(`places/${place.id}/`)}>
  <h3>{d.name}</h3>
  <p>{d.summary}</p>
  <div class="meta">
    <span><span class="dot" style={`--c:${t.color}`}></span>{t.single}</span>
    <span>{d.area}</span>
    {d.badge && <span class:list={['badge', d.badge]}>{badgeInfo(d.badge)?.short}</span>}
    {d.visibility === 'draft' && <span class="badge draft">Draft</span>}
    {shownTags.map((x) => <span class="tag">{TAGS[x as keyof typeof TAGS]}</span>)}
  </div>
</a>
