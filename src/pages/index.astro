---
import Base from '../layouts/Base.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { loadAll, site, u, typeInfo, SHOW_DRAFTS } from '../lib/data';
import { TYPES } from '../lib/vocab.mjs';

const { places, themes, trails } = await loadAll();
const countFor = (id: string) => places.filter((p) => p.data.themes.includes(id)).length;
// On the published site, only themes with at least one place appear.
const shownThemes = themes.filter((t) => SHOW_DRAFTS || countFor(t.id) > 0);
const favourites = places.filter((p) => p.data.badge === 'favourite').slice(0, 6);
const types = Object.keys(TYPES)
  .map((t) => ({ t, n: places.filter((p) => p.data.type === t).length }))
  .filter((x) => x.n > 0);
---
<Base current="home">
  <section class="hero wrap">
    <p class="eyebrow">A guide for our friends and family</p>
    <h1>{site.title}</h1>
    <p class="lede">{site.tagline}</p>
    <div class="prose">
      <p>You've probably already got the Tower and the British Museum on your list, and they're worth it. This is everything else: the places we take people when they visit, organized by what you're into. Pick a theme, open the map, or follow one of our trails.</p>
    </div>
    <div class="actions">
      <a class="button" href={u('map/')}>Open the map</a>
      {trails.length > 0 && <a class="button secondary" href={u('trails/')}>Follow a trail</a>}
      <a class="button secondary" href={u('practical/')}>Practical London</a>
    </div>
  </section>

  <section class="wrap" id="themes">
    <h2>What are you into?</h2>
    <div class="grid">
      {shownThemes.map((t) => (
        <a class="card theme-tile" href={u(`themes/${t.id}/`)} style={`--c:${t.data.color}`}>
          <h3>{t.data.title}</h3>
          <p>{t.data.blurb}</p>
          <span class="count">{countFor(t.id) ? `${countFor(t.id)} place${countFor(t.id) === 1 ? '' : 's'}` : 'Coming soon'}</span>
        </a>
      ))}
    </div>
  </section>

  {types.length > 0 && (
    <section class="wrap">
      <h2>Or browse by type</h2>
      <ul class="chips">
        {types.map(({ t, n }) => (
          <li><a href={u(`types/${t}/`)}><span class="dot" style={`--c:${typeInfo(t).color}`}></span>{typeInfo(t).label} <span class="muted">{n}</span></a></li>
        ))}
      </ul>
    </section>
  )}

  {favourites.length > 0 && (
    <section class="wrap">
      <h2>Family favourites</h2>
      <div class="grid">{favourites.map((p) => <PlaceCard place={p} />)}</div>
    </section>
  )}
</Base>
